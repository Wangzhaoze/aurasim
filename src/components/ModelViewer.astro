---
interface Props {
  src: string;
  alt?: string;
}
const { src, alt } = Astro.props;
---

<model-viewer
  class="my-6 block w-full aspect-[4/3] min-h-[36rem] overflow-hidden rounded-lg bg-zinc-200 dark:bg-zinc-800"
  alt={alt}
  src={src}
  camera-controls
  disable-zoom
  min-camera-orbit="auto auto 0.5m"
  max-camera-orbit="auto auto 10000m"
  interaction-prompt="auto"
></model-viewer>
<script>
  import "@google/model-viewer";

  const viewers = document.querySelectorAll("model-viewer");

  viewers.forEach((viewer) => {
    viewer.addEventListener(
      "wheel",
      (event) => {
        event.preventDefault();

        const orbit = viewer.getCameraOrbit?.();
        if (!orbit) return;

        const direction = event.deltaY > 0 ? 1 : -1;
        const zoomFactor = direction > 0 ? 1.07 : 1 / 1.07;
        const nextRadius = Math.min(10000, Math.max(0.5, orbit.radius * zoomFactor));

        viewer.cameraOrbit = `${orbit.theta}rad ${orbit.phi}rad ${nextRadius}m`;
        viewer.jumpCameraToGoal?.();
      },
      { passive: false },
    );
  });
</script>
