---
interface Props {
  src: string;
  alt?: string;
}
const { src, alt } = Astro.props;
---

<div class="viewer-wrap relative my-6">
  <model-viewer
    class="block w-full aspect-[4/3] min-h-[36rem] overflow-hidden rounded-lg bg-zinc-200 dark:bg-zinc-800"
    alt={alt}
    src={src}
    camera-controls
    disable-zoom
    field-of-view="45deg"
    min-camera-orbit="auto auto 0.10m"
    max-camera-orbit="auto auto 10000m"
    interaction-prompt="auto"
    touch-action="pan-y"
  ></model-viewer>
  <div class="pointer-events-none absolute bottom-3 right-3 rounded-md bg-black/55 px-2.5 py-1.5 text-xs text-white backdrop-blur-sm">
    Double-click to focus · Wheel to dolly
  </div>
</div>

<script>
  import "@google/model-viewer";

  const viewers = document.querySelectorAll("model-viewer");

  viewers.forEach((viewer) => {
    // Blender-like dolly: physically move the camera toward/away from the
    // current focus target, but with a deliberately small wheel step.
    viewer.addEventListener(
      "wheel",
      (event) => {
        event.preventDefault();

        const orbit = viewer.getCameraOrbit?.();
        if (!orbit) return;

        const zoomIn = event.deltaY < 0;
        const factor = zoomIn ? 0.965 : 1 / 0.965;
        const nextRadius = Math.min(10000, Math.max(0.10, orbit.radius * factor));

        viewer.cameraOrbit = `${orbit.theta}rad ${orbit.phi}rad ${nextRadius}m`;
        viewer.jumpCameraToGoal?.();
      },
      { passive: false },
    );

    // Double-click a visible surface to make that 3D point the new orbit and
    // dolly target. This is analogous to focusing a selection in Blender and
    // avoids zooming toward the center of a huge ground plane.
    viewer.addEventListener("dblclick", (event) => {
      const hit = viewer.positionAndNormalFromPoint?.(event.clientX, event.clientY);
      if (!hit) return;

      viewer.cameraTarget = hit.position.toString();
      viewer.jumpCameraToGoal?.();
    });
  });
</script>
