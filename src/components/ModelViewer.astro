---
interface Props {
  src: string;
  alt?: string;
}
const { src, alt } = Astro.props;
---

<model-viewer
  class="my-6 block w-full aspect-[4/3] min-h-[36rem] overflow-hidden rounded-lg bg-zinc-200 dark:bg-zinc-800"
  alt={alt}
  src={src}
  camera-controls
  disable-zoom
  min-camera-orbit="auto auto auto"
  max-camera-orbit="auto auto auto"
  min-field-of-view="8deg"
  max-field-of-view="70deg"
  interaction-prompt="auto"
></model-viewer>
<script>
  import "@google/model-viewer";

  const viewers = document.querySelectorAll("model-viewer");

  viewers.forEach((viewer) => {
    viewer.addEventListener(
      "wheel",
      (event) => {
        event.preventDefault();

        const currentFov = viewer.getFieldOfView?.();
        if (typeof currentFov !== "number") return;

        // Zoom by changing field of view instead of physically moving the
        // camera into the model. This greatly reduces near-plane / inside-mesh
        // clipping in large scenes such as the ray-tracing parking lot.
        const zoomIn = event.deltaY < 0;
        const factor = zoomIn ? 0.94 : 1.06;
        const nextFov = Math.min(70, Math.max(8, currentFov * factor));

        viewer.fieldOfView = `${nextFov}deg`;
        viewer.jumpCameraToGoal?.();
      },
      { passive: false },
    );
  });
</script>
