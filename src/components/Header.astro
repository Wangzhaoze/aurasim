---
import { Icon } from "astro-icon/components";

type Author = {
  name: string;
  url?: string;
  institution?: string;
  notes?: string[];
};

type Note = {
  symbol: string;
  text: string;
};

type Link = {
  url: string;
  name: string;
  icon?: string;
};

interface Props {
  title: string;
  authors: Author[];
  conference?: string;
  notes?: Note[];
  links?: Link[];
}

const { title, authors, conference, notes, links } = Astro.props;
const hasBackground = Astro.slots.has("background");
const hasTitleSlot = Astro.slots.has("title");
---

<header class:list={["full-bleed relative mb-12", hasBackground && "-mt-16 pt-24 pb-28"]}>
  {hasBackground && (
    <div class="cover absolute inset-0 z-0 overflow-hidden">
      <slot name="background" />
      <div class="absolute inset-0 bg-black/40" />
    </div>
  )}
  <div class:list={[
    "relative z-10 mx-auto flex max-w-[90rem] flex-col items-center px-8 text-center",
    hasBackground ? "gap-10 text-white prose-headings:text-white [text-shadow:0_0_8px_rgba(0,0,0,0.6)]" : "gap-6",
  ]}>
    <h1 class="my-0 max-w-[80rem] text-5xl font-medium leading-tight">
      {hasTitleSlot ? <slot name="title" /> : title}
    </h1>

    <div class="grid w-full max-w-[64rem] grid-cols-2 items-start justify-items-center gap-x-6 gap-y-4 md:grid-cols-4">
      {authors.map((author) => (
        <div class="flex min-w-0 flex-col items-center text-center">
          <div class="flex flex-row whitespace-nowrap text-xl">
            {author.url ? (
              <a class:list={[hasBackground && "not-prose text-blue-200 hover:text-blue-100 underline decoration-dashed underline-offset-4 hover:decoration-solid"]} href={author.url}>{author.name}</a>
            ) : author.name}
            {author.notes && <sup class="text-xl">{author.notes.map((note, i, array) => note + (i < array.length - 1 ? "," : ""))}</sup>}
          </div>
          {author.institution && <div>{author.institution}</div>}
        </div>
      ))}
    </div>

    {conference && <div>{conference}</div>}
    {notes && (
      <div class="flex flex-col items-center gap-1 text-center text-sm">
        {notes.map((note) => <div><sup>{note.symbol}</sup>{note.text}</div>)}
      </div>
    )}
    {links && (
      <div class="not-prose flex flex-row flex-wrap justify-center gap-2">
        {links.map((link) => (
          <a href={link.url} class:list={["flex flex-row items-center gap-2 rounded-full px-5 py-2 text-lg hover:no-underline", hasBackground ? "bg-white hover:bg-zinc-200 text-zinc-800 text-shadow-none shadow-[0_0_8px_rgba(0,0,0,0.6)]" : "bg-zinc-800 text-white hover:bg-black dark:text-zinc-900 dark:hover:bg-zinc-50 dark:bg-zinc-200"]}>
            {link.icon && <Icon name={link.icon} />}
            <span>{link.name}</span>
          </a>
        ))}
      </div>
    )}
  </div>
</header>

<style>
  .cover :global(:is(picture, img, video)) {
    position: absolute;
    inset: 0;
    margin: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    border-radius: 0;
  }
</style>
